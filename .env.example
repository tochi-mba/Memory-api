# Copy to .env for local runs. Never commit .env.
#
# An unknown MEMORY_* variable is a startup error, not a warning: a misspelled setting
# that is silently ignored looks exactly like a correctly configured service.

MEMORY_ENVIRONMENT=local
MEMORY_LOG_LEVEL=INFO
# Accepted for family parity; nothing reads it yet. See docs/operations.md.
MEMORY_LOG_FORMAT=console
MEMORY_HOST=127.0.0.1
MEMORY_PORT=8009

# Where every memory lives. It holds a person's own words in plaintext, so it is
# gitignored, and `:memory:` is accepted for a throwaway run.
MEMORY_DATABASE_PATH=var/memory.db

# Erasure. A forget is reversible until the grace period runs out; after that a background
# sweep deletes the row for good. Set the interval to 0 on every process but one when
# several share a database.
MEMORY_FORGET_GRACE_SECONDS=2592000
MEMORY_SWEEP_INTERVAL_SECONDS=3600

# Idle merge. Memories unused for this long in the same topic become one summary.
# Set the interval to 0 to turn the pass off.
MEMORY_CONSOLIDATE_IDLE_SECONDS=2592000
MEMORY_CONSOLIDATE_INTERVAL_SECONDS=3600

# Sibling services admitted to /v1/internal. Empty refuses every caller. Values are
# 32+ character tokens, never a person token.
# MEMORY_SERVICE_TOKENS={"lucy-api":"replace-with-32-plus-character-token"}

# Per-person settings. Both or neither: half a pair is a startup error. Set, a new memory
# is held to the importance floor its owner chose in settings-api. Unset keeps everything.
# MEMORY_SETTINGS_API_BASE_URL=http://127.0.0.1:8003
# MEMORY_SETTINGS_API_TOKEN=replace-with-32-plus-character-token

# Identity. MEMORY_AUDIENCE must equal this service's name in keyring's service registry.
MEMORY_KEYRING_JWKS_URL=http://127.0.0.1:8001/.well-known/jwks.json
MEMORY_KEYRING_ISSUER=http://127.0.0.1:8001
MEMORY_AUDIENCE=memory-api

# Key caching. The defaults are right for almost everyone; see docs/operations.md before
# changing the refetch floor.
# MEMORY_JWKS_CACHE_SECONDS=3600
# MEMORY_JWKS_MIN_REFETCH_SECONDS=30
# MEMORY_KEYRING_TIMEOUT_SECONDS=5
